<Project Sdk="Microsoft.NET.Sdk">
  <!-- Import user-specific Windows development/deployment paths. -->
  <Import Project="local.props" Condition="Exists('local.props')" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <SelfContained>false</SelfContained>

    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Windows-only development launch settings; they do not affect the DLL. -->
    <StartAction>Program</StartAction>
    <StartProgram>$(STS2GamePath)\SlayTheSpire2.exe</StartProgram>
    <StartWorkingDirectory>$(STS2GamePath)</StartWorkingDirectory>

    <!-- Machine-specific path defaults if local.props is missing. -->
    <STS2GamePath Condition="'$(STS2GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</STS2GamePath>
    <GodotExePath Condition="'$(GodotExePath)' == ''">godot</GodotExePath>

    <!-- Tracked mod identity. Archipelago.json owns the user-visible mod version. -->
    <ModName>Archipelago</ModName>
    <ModDisplayName>Archipelago Client</ModDisplayName>
    <ModAuthor>Kirbyfanner, PlatanoBailando, Lyxn, MartyredG, Terairk</ModAuthor>

    <AssemblyName>$(ModName)</AssemblyName>

    <!-- Build/deploy paths on the Windows build machine. -->
    <ModsOutputDir>$(STS2GamePath)\mods\$(ModName)</ModsOutputDir>
    <GameDataDir>$(STS2GamePath)\data_sts2_windows_x86_64</GameDataDir>
    <STS2ReferenceDataDir Condition="'$(STS2ReferenceDataDir)' == ''">$(GameDataDir)</STS2ReferenceDataDir>
    <GodotProject>$(ProjectDir)godot</GodotProject>
    <GodotPackPreset>Windows Desktop</GodotPackPreset>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
    <PackageReference Include="STS2.RitsuLib.Compat.0.107.1" Version="0.5.14" />
  </ItemGroup>

  <ItemGroup>
    <!--
      These are compile-time references to managed game assemblies. Referencing
      the Windows copies does not make the output DLL Windows-native.
    -->
    <Reference Include="0Harmony">
      <HintPath>$(STS2ReferenceDataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2ReferenceDataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(STS2ReferenceDataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Archipelago.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Archipelago.json" LogicalName="StS2AP.Archipelago.json" />
    <EmbeddedResource
      Include="..\..\world\spire2\archipelago.json"
      LogicalName="StS2AP.Spire2Archipelago.json"
    />
  </ItemGroup>

  <!-- Create steam_appid.txt for Windows debugging outside Steam. -->
  <Target Name="CreateSteamAppId" BeforeTargets="Build">
    <PropertyGroup>
      <SteamAppIdPath>$(STS2GamePath)\steam_appid.txt</SteamAppIdPath>
      <SteamAppId>2868840</SteamAppId>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(SteamAppIdPath)"
      Lines="$(SteamAppId)"
      Overwrite="true"
      Encoding="ASCII"
      WriteOnlyWhenDifferent="true"
    />
    <Message Text="Created steam_appid.txt with App ID $(SteamAppId)" Importance="high" />
  </Target>

  <Target Name="CreateGodotFolder" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(GodotProject)" />
    <Message Text="Created Godot folder structure" Importance="high" />
  </Target>

  <Target
    Name="GenerateProjectGodot"
    BeforeTargets="BeforeBuild"
    DependsOnTargets="CreateGodotFolder"
  >
    <PropertyGroup>
      <ProjectGodotPath>$(GodotProject)\project.godot</ProjectGodotPath>
      <ProjectGodotContent>
config_version=5

[application]
config/name="$(ModName)"
config/features=PackedStringArray("4.5", "Forward Plus")

[dotnet]
project/assembly_name="$(ModName)"
      </ProjectGodotContent>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(ProjectGodotPath)"
      Lines="$(ProjectGodotContent)"
      Overwrite="true"
      Encoding="UTF-8"
    />
    <Message Text="Generated project.godot" Importance="high" />
  </Target>

  <!--
    Godot requires a platform preset even for a PCK-only export. This target emits
    only a PCK resource pack: it does not emit or embed a Windows x64 executable.
  -->
  <Target
    Name="GenerateExportPresets"
    BeforeTargets="BeforeBuild"
    DependsOnTargets="CreateGodotFolder"
  >
    <PropertyGroup>
      <ExportPresetsPath>$(GodotProject)\export_presets.cfg</ExportPresetsPath>
      <ExportPresetsContent>
        <![CDATA[config_version=5

[preset.0]

name="Windows Desktop"
platform="Windows Desktop"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path=""
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug=""
custom_template/release=""
debug/export_console_wrapper=1
binary_format/embed_pck=false
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false
shader_baker/enabled=false
binary_format/architecture="x86_64"
codesign/enable=false
codesign/timestamp=true
codesign/timestamp_server_url=""
codesign/digest_algorithm=1
codesign/description=""
codesign/custom_options=PackedStringArray()
application/modify_resources=true
application/icon=""
application/console_wrapper_icon=""
application/icon_interpolation=4
application/file_version=""
application/product_version=""
application/company_name=""
application/product_name=""
application/file_description=""
application/copyright=""
application/trademarks=""
application/export_angle=0
application/export_d3d12=0
application/d3d12_agility_sdk_multiarch=true
ssh_remote_deploy/enabled=false
ssh_remote_deploy/host="user@host_ip"
ssh_remote_deploy/port="22"
ssh_remote_deploy/extra_args_ssh=""
ssh_remote_deploy/extra_args_scp=""
ssh_remote_deploy/run_script="Expand-Archive -LiteralPath '{temp_dir}\\{archive_name}' -DestinationPath '{temp_dir}'
$action = New-ScheduledTaskAction -Execute '{temp_dir}\\{exe_name}' -Argument '{cmd_args}'
$trigger = New-ScheduledTaskTrigger -Once -At 00:00
$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
$task = New-ScheduledTask -Action $action -Trigger $trigger -Settings $settings
Register-ScheduledTask godot_remote_debug -InputObject $task -Force:$true
Start-ScheduledTask -TaskName godot_remote_debug
while (Get-ScheduledTask -TaskName godot_remote_debug | ? State -eq running) { Start-Sleep -Milliseconds 100 }
Unregister-ScheduledTask -TaskName godot_remote_debug -Confirm:$false -ErrorAction:SilentlyContinue"
ssh_remote_deploy/cleanup_script="Stop-ScheduledTask -TaskName godot_remote_debug -ErrorAction:SilentlyContinue
Unregister-ScheduledTask -TaskName godot_remote_debug -Confirm:$false -ErrorAction:SilentlyContinue
Remove-Item -Recurse -Force '{temp_dir}'"
dotnet/include_scripts_content=false
dotnet/include_debug_symbols=true
dotnet/embed_build_outputs=false
]]>
      </ExportPresetsContent>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(ExportPresetsPath)"
      Lines="$(ExportPresetsContent)"
      Overwrite="true"
      Encoding="UTF-8"
    />
    <Message Text="Generated export_presets.cfg" Importance="high" />
  </Target>

  <Target Name="PostBuild" AfterTargets="Build">
    <MakeDir Directories="$(ModsOutputDir)" />

    <!-- Copy the AnyCPU mod assembly. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsOutputDir)" />

    <!-- Copy managed NuGet dependencies, excluding assemblies supplied by the game/RitsuLib mod. -->
    <ItemGroup>
      <DependencyDlls
        Include="$(TargetDir)*.dll"
        Exclude="$(TargetDir)$(TargetFileName);$(TargetDir)GodotSharp.dll;$(TargetDir)0Harmony.dll;$(TargetDir)sts2.dll;$(TargetDir)STS2.RitsuLib*.dll;$(TargetDir)STS2-RitsuLib*.dll"
      />
    </ItemGroup>
    <Copy SourceFiles="@(DependencyDlls)" DestinationFolder="$(ModsOutputDir)" />
    <Copy SourceFiles="Archipelago.json" DestinationFiles="$(ModsOutputDir)\Archipelago.json" />

    <!-- Copy the APWorld if it has already been built. -->
    <PropertyGroup>
      <ApWorldSource>$(MSBuildProjectDirectory)\..\..\dist\spire2.apworld</ApWorldSource>
      <ApWorldDest>$(ModsOutputDir)\spire2.apworld</ApWorldDest>
    </PropertyGroup>
    <Copy
      SourceFiles="$(ApWorldSource)"
      DestinationFiles="$(ApWorldDest)"
      Condition="Exists('$(ApWorldSource)')"
    />
    <Warning
      Text="spire2.apworld not found in dist folder. Run scripts\build_world.ps1 to build it."
      Condition="!Exists('$(ApWorldSource)')"
    />

    <!-- The preset architecture applies to executables, not this PCK-only export. -->
    <Exec Command="&quot;$(GodotExePath)&quot; --headless --path &quot;$(GodotProject)&quot; --export-pack &quot;$(GodotPackPreset)&quot; &quot;$(ModsOutputDir)\$(ModName).pck&quot;" />
  </Target>
</Project>
