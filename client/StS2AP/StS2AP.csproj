<Project Sdk="Microsoft.NET.Sdk">
	<!-- Import user-specific paths -->
	<Import Project="local.props" Condition="Exists('local.props')" />

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>$(WarningsAsErrors);nullable;CS8509;CS0612;CS0618;CS4014;CS0162;CS1998;CS0108;CS0114;CS1717</WarningsAsErrors>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<!-- One source tree is compiled against each explicitly supported game API. -->
		<SupportedSts2ApiCompats>0.107.1;0.111.0</SupportedSts2ApiCompats>
		<DefaultSts2ApiCompat>0.111.0</DefaultSts2ApiCompat>
		<Sts2ApiCompat Condition="'$(Sts2ApiCompat)' == ''">$(DefaultSts2ApiCompat)</Sts2ApiCompat>
		<UseSts2RefLib Condition="'$(UseSts2RefLib)' == ''">false</UseSts2RefLib>
		<Sts2RefLibPackageVersion Condition="'$(Sts2ApiCompat)' == '0.107.1'">0.107.1</Sts2RefLibPackageVersion>
		<Sts2RefLibPackageVersion Condition="'$(Sts2ApiCompat)' == '0.111.0'">0.111.0-beta</Sts2RefLibPackageVersion>
		<STS2ReferenceDataDir01071 Condition="'$(STS2ReferenceDataDir01071)' == '' and '$(Sts2ApiSignatureRoot)' != ''">$(Sts2ApiSignatureRoot)\0.107.1</STS2ReferenceDataDir01071>
		<STS2ReferenceDataDir01110 Condition="'$(STS2ReferenceDataDir01110)' == '' and '$(Sts2ApiSignatureRoot)' != ''">$(Sts2ApiSignatureRoot)\0.111.0</STS2ReferenceDataDir01110>
		<Sts2ApiSignatureDir Condition="'$(Sts2ApiCompat)' == '0.107.1' and '$(STS2ReferenceDataDir01071)' != ''">$(STS2ReferenceDataDir01071)</Sts2ApiSignatureDir>
		<Sts2ApiSignatureDir Condition="'$(Sts2ApiCompat)' == '0.111.0' and '$(STS2ReferenceDataDir01110)' != ''">$(STS2ReferenceDataDir01110)</Sts2ApiSignatureDir>
		<Sts2ApiSignatureDir Condition="'$(Sts2ApiSignatureDir)' == '' and '$(Sts2ApiSignatureRoot)' != ''">$(Sts2ApiSignatureRoot)\$(Sts2ApiCompat)</Sts2ApiSignatureDir>
		<STS2ReferenceDataDir Condition="'$(Sts2ApiSignatureDir)' != ''">$(Sts2ApiSignatureDir)</STS2ReferenceDataDir>
		<IntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(Sts2ApiCompat)\$(Configuration)\</IntermediateOutputPath>
		<OutputPath>$(MSBuildProjectDirectory)\bin\$(Sts2ApiCompat)\$(Configuration)\</OutputPath>
		<DefineConstants Condition="'$(Sts2ApiCompat)' == '0.107.1'">$(DefineConstants);STS2_0_107_1</DefineConstants>
		<DefineConstants Condition="'$(Sts2ApiCompat)' == '0.111.0'">$(DefineConstants);STS2_0_111_0;STS2_AT_LEAST_0_111_0</DefineConstants>
		<DllOnlyBuild Condition="'$(DllOnlyBuild)' == ''">false</DllOnlyBuild>

		<!-- Debug settings -->
		<StartAction>Program</StartAction>
		<StartProgram>$(STS2GamePath)\SlayTheSpire2.exe</StartProgram>
		<StartWorkingDirectory>$(STS2GamePath)</StartWorkingDirectory>

		<!-- Machine-specific path defaults if local.props is missing. -->
		<STS2GamePath Condition="'$(STS2GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</STS2GamePath>
		<GodotExePath Condition="'$(GodotExePath)' == ''">godot</GodotExePath>

		<!-- Tracked mod identity. Archipelago.json owns the user-visible mod version. -->
		<ModName>Archipelago</ModName>
		<ModDisplayName>Archipelago Client</ModDisplayName>
		<ModAuthor>Kirbyfanner, PlatanoBailando, Lyxn, MartyredG, Terairk</ModAuthor>

		<AssemblyName>$(ModName)</AssemblyName>

		<!-- Derived paths -->
		<ModsOutputDir>$(STS2GamePath)\mods\$(ModName)</ModsOutputDir>
		<GameDataDir>$(STS2GamePath)\data_sts2_windows_x86_64</GameDataDir>
		<STS2ReferenceDataDir Condition="'$(STS2ReferenceDataDir)' == ''">$(GameDataDir)</STS2ReferenceDataDir>
		<GodotProject>$(ProjectDir)godot</GodotProject>
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\StS2AP.Domain\StS2AP.Domain.fsproj" />
	  <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.0" />
	  <PackageReference Include="Book.StS2.RefLib" Version="$(Sts2RefLibPackageVersion)" PrivateAssets="all" Condition="'$(UseSts2RefLib)' == 'true' and '$(Sts2RefLibPackageVersion)' != ''" />
	  <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" Condition="'$(UseSts2RefLib)' != 'true'" />
	  <PackageReference Include="STS2.RitsuLib.Compat.0.107.1" Version="0.5.17" />
	</ItemGroup>

	<ItemGroup>
	  <Publicize Include="sts2" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false" Condition="'$(UseSts2RefLib)' != 'true'" />
	  <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
	    <_Parameter1>Sts2ApiCompat</_Parameter1>
	    <_Parameter2>$(Sts2ApiCompat)</_Parameter2>
	  </AssemblyAttribute>
	</ItemGroup>

	<ItemGroup Condition="'$(UseSts2RefLib)' != 'true'">
		<Reference Include="0Harmony">
			<HintPath>$(STS2ReferenceDataDir)\0Harmony.dll</HintPath>
		</Reference>
		<Reference Include="GodotSharp">
			<HintPath>$(STS2ReferenceDataDir)\GodotSharp.dll</HintPath>
		</Reference>
		<Reference Include="sts2">
			<HintPath>$(STS2ReferenceDataDir)\sts2.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Archipelago.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <EmbeddedResource Include="Archipelago.json" LogicalName="StS2AP.Archipelago.json" />
	  <EmbeddedResource Include="..\..\world\spire2\archipelago.json" LogicalName="StS2AP.Spire2Archipelago.json" />
	</ItemGroup>

	<!-- Create steam_appid.txt for debugging outside Steam -->
	<!-- Compile-only validation must embed the same manifests as Build. Without resource
	     preparation, -t:Compile can replace the intermediate DLL with a resource-free one
	     which a later incremental Build then copies into the compatibility bundle. -->
	<Target Name="PrepareClientResourcesForCompile"
	        BeforeTargets="_GenerateCompileInputs"
	        DependsOnTargets="PrepareResources" />

	<Target Name="ValidateSts2ApiCompat" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="!$([System.String]::Copy(';$(SupportedSts2ApiCompats);').Contains(';$(Sts2ApiCompat);'))"
		       Text="Unsupported Sts2ApiCompat '$(Sts2ApiCompat)'. Supported targets: $(SupportedSts2ApiCompats)." />
		<Error Condition="'$(UseSts2RefLib)' == 'true' and '$(Sts2RefLibPackageVersion)' == ''"
		       Text="No Book.StS2.RefLib package is mapped for STS2 API $(Sts2ApiCompat)." />
		<Error Condition="'$(UseSts2RefLib)' != 'true' and '$(Sts2ApiSignatureRoot)' != '' and !Exists('$(Sts2ApiSignatureRoot)')"
		       Text="Sts2ApiSignatureRoot does not exist: '$(Sts2ApiSignatureRoot)'." />
		<Error Condition="'$(UseSts2RefLib)' != 'true' and !Exists('$(STS2ReferenceDataDir)\sts2.dll')"
		       Text="Missing sts2.dll for STS2 $(Sts2ApiCompat): '$(STS2ReferenceDataDir)\sts2.dll'. Set Sts2ApiSignatureRoot to a directory containing numeric version folders, or set UseSts2RefLib=true." />
		<Error Condition="'$(UseSts2RefLib)' != 'true' and !Exists('$(STS2ReferenceDataDir)\0Harmony.dll')"
		       Text="Missing 0Harmony.dll for STS2 $(Sts2ApiCompat): '$(STS2ReferenceDataDir)\0Harmony.dll'." />
		<Error Condition="'$(UseSts2RefLib)' != 'true' and !Exists('$(STS2ReferenceDataDir)\GodotSharp.dll')"
		       Text="Missing GodotSharp.dll for STS2 $(Sts2ApiCompat): '$(STS2ReferenceDataDir)\GodotSharp.dll'." />
	</Target>

	<Target Name="CreateSteamAppId" BeforeTargets="Build" Condition="'$(DllOnlyBuild)' != 'true'">
		<PropertyGroup>
			<SteamAppIdPath>$(STS2GamePath)\steam_appid.txt</SteamAppIdPath>
			<SteamAppId>2868840</SteamAppId>
		</PropertyGroup>
		<WriteLinesToFile File="$(SteamAppIdPath)" Lines="$(SteamAppId)" Overwrite="true" Encoding="ASCII" WriteOnlyWhenDifferent="false" />
		<Exec Command="powershell -Command &quot;Set-Content -Path '$(SteamAppIdPath)' -Value '$(SteamAppId)' -NoNewline -Encoding ASCII&quot;" />
		<Message Text="Created steam_appid.txt with App ID $(SteamAppId)" Importance="high" />
	</Target>

	<!-- Create Godot folder structure -->
	<Target Name="CreateGodotFolder" BeforeTargets="BeforeBuild" Condition="'$(DllOnlyBuild)' != 'true'">
		<MakeDir Directories="$(GodotProject)" />
		<Message Text="Created Godot folder structure" Importance="high" />
	</Target>

	<!-- Generate export_presets.cfg -->



	<!-- Generate project.godot -->
	<Target Name="GenerateProjectGodot" BeforeTargets="BeforeBuild" DependsOnTargets="CreateGodotFolder" Condition="'$(DllOnlyBuild)' != 'true'">
		<PropertyGroup>
			<ProjectGodotPath>$(GodotProject)\project.godot</ProjectGodotPath>
			<ProjectGodotContent>
config_version=5

[application]
config/name="$(ModName)"
config/features=PackedStringArray("4.5", "Forward Plus")

[dotnet]
project/assembly_name="$(ModName)"
			</ProjectGodotContent>
		</PropertyGroup>

		<WriteLinesToFile File="$(ProjectGodotPath)" Lines="$(ProjectGodotContent)" Overwrite="true" Encoding="UTF-8" />
		<Message Text="Generated project.godot" Importance="high" />
	</Target>

	<Target Name="GenerateExportPresets" BeforeTargets="BeforeBuild" DependsOnTargets="CreateGodotFolder" Condition="'$(DllOnlyBuild)' != 'true'">
		<PropertyGroup>
			<ExportPresetsPath>$(GodotProject)\export_presets.cfg</ExportPresetsPath>
			<ExportPresetsContent>
				<![CDATA[config_version=5

[preset.0]

name="Windows Desktop"
platform="Windows Desktop"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path=""
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug=""
custom_template/release=""
debug/export_console_wrapper=1
binary_format/embed_pck=false
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false
shader_baker/enabled=false
binary_format/architecture="x86_64"
codesign/enable=false
codesign/timestamp=true
codesign/timestamp_server_url=""
codesign/digest_algorithm=1
codesign/description=""
codesign/custom_options=PackedStringArray()
application/modify_resources=true
application/icon=""
application/console_wrapper_icon=""
application/icon_interpolation=4
application/file_version=""
application/product_version=""
application/company_name=""
application/product_name=""
application/file_description=""
application/copyright=""
application/trademarks=""
application/export_angle=0
application/export_d3d12=0
application/d3d12_agility_sdk_multiarch=true
ssh_remote_deploy/enabled=false
ssh_remote_deploy/host="user@host_ip"
ssh_remote_deploy/port="22"
ssh_remote_deploy/extra_args_ssh=""
ssh_remote_deploy/extra_args_scp=""
ssh_remote_deploy/run_script="Expand-Archive -LiteralPath '{temp_dir}\\{archive_name}' -DestinationPath '{temp_dir}'
$action = New-ScheduledTaskAction -Execute '{temp_dir}\\{exe_name}' -Argument '{cmd_args}'
$trigger = New-ScheduledTaskTrigger -Once -At 00:00
$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
$task = New-ScheduledTask -Action $action -Trigger $trigger -Settings $settings
Register-ScheduledTask godot_remote_debug -InputObject $task -Force:$true
Start-ScheduledTask -TaskName godot_remote_debug
while (Get-ScheduledTask -TaskName godot_remote_debug | ? State -eq running) { Start-Sleep -Milliseconds 100 }
Unregister-ScheduledTask -TaskName godot_remote_debug -Confirm:$false -ErrorAction:SilentlyContinue"
ssh_remote_deploy/cleanup_script="Stop-ScheduledTask -TaskName godot_remote_debug -ErrorAction:SilentlyContinue
Unregister-ScheduledTask -TaskName godot_remote_debug -Confirm:$false -ErrorAction:SilentlyContinue
Remove-Item -Recurse -Force '{temp_dir}'"
dotnet/include_scripts_content=false
dotnet/include_debug_symbols=true
dotnet/embed_build_outputs=false
]]>
			</ExportPresetsContent>
		</PropertyGroup>

		<WriteLinesToFile File="$(ExportPresetsPath)" Lines="$(ExportPresetsContent)" Overwrite="true" Encoding="UTF-8" />
		<Message Text="Generated export_presets.cfg" Importance="high" />
	</Target>


	<Target Name="PostBuild" AfterTargets="Build" Condition="'$(DllOnlyBuild)' != 'true'">
		<MakeDir Directories="$(ModsOutputDir)" />
		<!-- Copy main assembly -->
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsOutputDir)" />
		<!-- Copy all dependency DLLs (NuGet packages) except game-provided assemblies -->
		<ItemGroup>
			<DependencyDlls Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(TargetFileName);$(TargetDir)GodotSharp.dll;$(TargetDir)0Harmony.dll;$(TargetDir)sts2.dll;$(TargetDir)STS2.RitsuLib*.dll;$(TargetDir)STS2-RitsuLib*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(DependencyDlls)" DestinationFolder="$(ModsOutputDir)" />
		<Copy SourceFiles="Archipelago.json" DestinationFiles="$(ModsOutputDir)\Archipelago.json" />
		<!-- Copy .apworld file if it exists (dev builds may not have it yet) -->
		<PropertyGroup>
			<ApWorldSource>$(MSBuildProjectDirectory)\..\..\dist\spire2.apworld</ApWorldSource>
			<ApWorldDest>$(ModsOutputDir)\spire2.apworld</ApWorldDest>
		</PropertyGroup>
		<Copy SourceFiles="$(ApWorldSource)" DestinationFiles="$(ApWorldDest)" Condition="Exists('$(ApWorldSource)')" />
		<Warning Text="spire2.apworld not found in dist folder. Run scripts\build_world.ps1 to build it." Condition="!Exists('$(ApWorldSource)')" />
		<Exec Command="&quot;$(GodotExePath)&quot; --headless --path &quot;$(GodotProject)&quot; --export-pack &quot;Windows Desktop&quot; &quot;$(ModsOutputDir)\$(ModName).pck&quot;" />
	</Target>

	<Target Name="AssembleLocalCompatibilityBundle" AfterTargets="PostBuild" Condition="'$(DllOnlyBuild)' != 'true'">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\assemble_client_variants.ps1&quot; -Configuration &quot;$(Configuration)&quot; -ClientProject &quot;$(MSBuildProjectFullPath)&quot; -LoaderProject &quot;$(MSBuildProjectDirectory)\..\StS2AP.Loader\StS2AP.Loader.csproj&quot; -PublicReferenceDir &quot;$(STS2ReferenceDataDir01071)&quot; -BetaReferenceDir &quot;$(STS2ReferenceDataDir01110)&quot; -ModsOutputDir &quot;$(ModsOutputDir)&quot;" />
	</Target>
</Project>
